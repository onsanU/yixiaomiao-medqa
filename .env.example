# 医小喵存储后端配置（第5次迭代：MySQL 双模式，2026-09-07）
# 复制本文件为项目根 .env 后按需修改；不建 .env 则默认 SQLite（零配置）

# 存储后端：sqlite（默认）| mysql
YXM_DB=sqlite

# ── MySQL 连接（YXM_DB=mysql 时生效）────────────────────
# 注意：医小喵服务跑在 WSL，MySQL 跑在 Windows 本机 →
#   HOST 填 Windows 宿主 IP（WSL 里 `ip route | grep default` 的网关，常见 172.x.x.1）
#   且 MySQL my.ini 需 bind-address=0.0.0.0 + 已建 yixiaomiao 库和本账号
YXM_DB_HOST=172.30.160.1
YXM_DB_PORT=3306
YXM_DB_USER=yixiaomiao
YXM_DB_PASSWORD=yxm123456
YXM_DB_NAME=yixiaomiao
